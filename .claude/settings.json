{
  "permissions": {
    "allow": [
      "Bash(bash reconcile-repos.sh:*)"
    ]
  },
  "hooks": {
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "sh \"$CLAUDE_PROJECT_DIR/context-guard.sh\"",
            "timeout": 10
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$CLAUDE_PROJECT_DIR/.claude/hooks/guard-git-refs.py\"",
            "timeout": 10
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "sh \"$(git rev-parse --show-toplevel)/auto-commit.sh\"",
            "timeout": 30,
            "statusMessage": "Versioning the vault"
          }
        ]
      }
    ]
  },
  "enabledPlugins": {},
  "autoCompactWindow": 250000
}
