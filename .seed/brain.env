# brain.env — this brain's settings, one KEY=value per line. Scripts read one key at a time
# and never source this file. No secrets here. A missing or empty key takes the script's default.
# When a key appears twice, the first line wins.
CODE_ROOT=~/projects
PROTECTED_BRANCHES=main dev
DEFAULT_BACKEND=claude
NOTIFY=
DOCS_SITE_DIR=
DOCS_URL=
HTML_THEME=
CONTEXT_GUARD_THRESHOLD=150000
